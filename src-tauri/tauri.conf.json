{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chilly",
  "version": "0.2.4",
  "identifier": "fi.samppalandia.chilly",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://static-cdn.jtvnw.net data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Finnish"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer-hooks.nsh",
        "customLanguageFiles": {
          "Finnish": "nsis/Finnish.nsh"
        }
      }
    },
    "publisher": "SamppaLandia",
    "homepage": "https://samppalandia.wtf/chilly/",
    "copyright": "Copyright (c) 2026 SamppaLandia",
    "license": "MIT",
    "shortDescription": "Twitch-streamit, chat ja ilmoitukset",
    "longDescription": "Chilly is a free open-source Twitch desktop client for Windows with live notifications, multistream, chat with FFZ/BTTV/7TV emotes, watch streak priority and automatic bonus/drop claiming.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxN0QyQkZEMzY5MjRFREQKUldUZFRwSTIvU3Q5c2ZYa0pqTnBkZUFyN0R2QWFneG1sdCs0YjN4cHR2ZGxoYUwzTEoyaEttbUEK",
      "endpoints": [
        "https://samppalandia.wtf/chilly/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}